# IPv4 do computador na mesma rede Wi-Fi do celular.
# Use o endereco do adaptador Wi-Fi ou Ethernet, nao o IP do Docker.
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.100

# --- Firebase (config atual hardcoded em src/lib/firebase.ts) ---
# Template para migração futura; estas variáveis ainda não são lidas pelo app.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Previsão de chuva (módulo de ML em src/backend/ml) ---
ML_API_URL=http://localhost:8000
# Opcional: URL da API FastAPI para fallback direto no app durante desenvolvimento
# EXPO_PUBLIC_ML_API_URL=http://localhost:8000
